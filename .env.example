# Copy to .env.local (development) or set in your host's environment (production).
# Never commit real values. Generate secrets with: node scripts/generate-secrets.mjs

# --- Mode -------------------------------------------------------------------
# true  = browser-only demo with fictional data (no database, no server API)
# false = production: PostgreSQL, real accounts, server-side authorization
DEMO_MODE=true

# Public product name and contact shown in the UI (optional)
NEXT_PUBLIC_APP_NAME="HR & Payroll Suite"
NEXT_PUBLIC_SALES_EMAIL=sales@example.com

# --- Production (DEMO_MODE=false) ------------------------------------------
# Public URL of this deployment, used for same-origin checks and Stripe redirects.
APP_URL=https://payroll.example.com

# PostgreSQL 14+ connection string. Run `pnpm db:migrate` before each release.
DATABASE_URL=postgres://user:password@localhost:5432/hr_payroll
DATABASE_POOL_SIZE=10

# 32 random bytes, base64. Encrypts statutory IDs, bank accounts and 2FA secrets.
# Losing this key makes encrypted fields unreadable — store it in a secret manager.
DATA_ENCRYPTION_KEY=

# One-time token required by /setup to create the first organisation and owner.
# At least 16 characters. Remove it after setup if you like; setup is single-use anyway.
SETUP_TOKEN=

# Session idle timeout in hours (sliding; absolute maximum is 7 days).
SESSION_TTL_HOURS=12

# Where uploaded employee documents are stored: "database" (default) or "local".
STORAGE_DRIVER=database
# Used when STORAGE_DRIVER=local; must be a persistent volume.
STORAGE_DIR=./storage

# Set to false if the app is NOT behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=true

# --- Billing (optional; production only) ------------------------------------
# Hosted SaaS deployments only. Self-hosted ownership installs leave this false.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Price IDs (create them in the Stripe dashboard; amounts must match src/config/pricing.ts)
STRIPE_PRICE_HOSTED_SETUP=
STRIPE_PRICE_HOSTED_MONTHLY=
STRIPE_PRICE_OWNED=
